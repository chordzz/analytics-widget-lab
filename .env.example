# Copy to .env and point it at the API this build should talk to.
#
#   cp .env.example .env
#
# There is no default in the code. A missing value stops the dev server, the
# build, and the scripts with a message — it never falls back to a deployment.
#
# The app reads the VITE_-prefixed name because Vite exposes no others. The
# scripts (conform, boards, fetch-api-spec) read it too, so one line serves
# both; set ANALYTICS_BASE_URL as well only to point a script somewhere else.

VITE_ANALYTICS_API_BASE_URL=https://api.dev.analytics.penilabs.com

# Your own access token, for the scripts only. Never committed, never printed.
# Read it from the browser console while signed in:
#   copy(JSON.parse(localStorage.getItem('smc.analytics.auth.v1')).accessToken)
# ANALYTICS_TOKEN=
